# Copy this file to .env, then fill in your own API key.
#
# OpenAI example:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# Other OpenAI-compatible providers can also work if they support the
# chat/completions API. Change AI_BASE_URL and AI_MODEL to match that provider.

AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# The folder that contains your Markdown notes. "." means the current folder.
PAPERS_DIR=.

# Local generated content cache.
CACHE_PATH=data/cache.json
